{
  "manifest_version": 3,
  "name": "Job Data Harvester",
  "version": "1.1.0",
  "description": "Extracts structured JSON from job boards using local Gemini Nano and sends it directly to CVTailor's intake stage.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "images/icon-16.png",
    "32": "images/icon-32.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "images/icon-16.png",
      "32": "images/icon-32.png",
      "48": "images/icon-48.png"
    },
    "default_popup": "popup.html",
    "default_title": "Extract Job Details"
  },
  "commands": {
    "extract-job-details": {
      "suggested_key": {
        "default": "Alt+Shift+E",
        "mac": "Alt+Shift+E"
      },
      "description": "Extract job details from the current page"
    }
  }
}
